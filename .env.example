# --- Core settings (not secrets, but local to each machine) ---
# Contact address put in the User-Agent: "SignalBot/0.1 (+mailto:<this>)". Required before any live run.
SIGNAL_CONTACT_EMAIL=
# Secret salt for hashing author handles. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTHOR_HASH_SALT=
# SQLAlchemy URL. SQLite now; Postgres later, e.g. postgresql+psycopg://user:pass@host/signal
DATABASE_URL=sqlite:///data/signal.db
SOURCES_FILE=sources.yaml

# --- Source keys ---
BRAVE_API_KEY=
EXA_API_KEY=
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
THREADS_ACCESS_TOKEN=
META_GRAPH_TOKEN=            # Instagram hashtag search, Facebook Pages
PINTEREST_TOKEN=
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
FREELANCER_TOKEN=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
SAM_GOV_API_KEY=
REGULATIONS_GOV_API_KEY=
COURTLISTENER_TOKEN=
LEGISCAN_API_KEY=
OPENSTATES_API_KEY=
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=
PRODUCTHUNT_TOKEN=
GITHUB_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=  # Keyword Planner
SEMANTIC_SCHOLAR_KEY=
DOL_API_KEY=                 # OSHA enforcement data (dataportal.dol.gov)
CENSUS_API_KEY=              # api.census.gov now requires a key
STACKEXCHANGE_KEY=           # optional; raises quota 300 -> 10,000/day
BLUESKY_HANDLE=              # pending rule-1 decision
BLUESKY_APP_PASSWORD=

# --- Paid, optional (feature-flagged off by default) ---
YELP_API_KEY=
GOOGLE_PLACES_KEY=
NEWSAPI_KEY=
CRUNCHBASE_KEY=
SEMRUSH_KEY=
PACER_USERNAME=

# Feature flags for paid connectors. A paid source runs only when its flag is set to 1.
ENABLE_YELP=0
ENABLE_GOOGLE_PLACES=0
ENABLE_NEWSAPI=0
ENABLE_CRUNCHBASE=0
ENABLE_KEYWORDS_PAID=0
ENABLE_PACER=0
ENABLE_LISTENING=0
ENABLE_REDDIT_API=0

# Feed (signal_feed/): Stage A enrichment
ANTHROPIC_API_KEY=           # Claude tagging (Haiku 5.5, escalations to Opus 5.5); budget in config/feed.yaml
VOYAGE_API_KEY=              # Voyage AI embeddings (voyage-4); first 200M tokens free
FEED_DATABASE_URL=           # optional; default sqlite:///data/feed.db
